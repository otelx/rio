{
  "name": "main-reviewed-ci",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Go and source checks",
            "integration_id": 15368
          },
          {
            "context": "Build and load agents (amd64)",
            "integration_id": 15368
          },
          {
            "context": "Build and load agents (arm64)",
            "integration_id": 15368
          },
          {
            "context": "Integration (amd64, imageVolume)",
            "integration_id": 15368
          },
          {
            "context": "Integration (amd64, initContainer)",
            "integration_id": 15368
          },
          {
            "context": "Integration (arm64, imageVolume)",
            "integration_id": 15368
          },
          {
            "context": "Integration (arm64, initContainer)",
            "integration_id": 15368
          },
          {
            "context": "Verify multi-platform image selection",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
